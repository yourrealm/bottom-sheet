{
  "name": "@yourrealm/bottom-sheet",
  "version": "0.0.0",
  "description": "Native-feeling bottom sheet for the web. One native scroller for sheet travel and content.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourrealm/bottom-sheet.git",
    "directory": "packages/bottom-sheet"
  },
  "homepage": "https://yourrealm.github.io/bottom-sheet/",
  "bugs": "https://github.com/yourrealm/bottom-sheet/issues",
  "keywords": [
    "react",
    "bottom-sheet",
    "sheet",
    "drawer",
    "scroll-snap",
    "mobile",
    "headless"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styled": "./src/styled/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "prepack": "node scripts/prepack.mjs && pnpm build",
    "postpack": "rm -f README.md LICENSE",
    "pack:check": "node scripts/prepack.mjs && pnpm build && pnpm pack; rm -f README.md LICENSE",
    "release": "node scripts/prepack.mjs && pnpm build && pnpm publish --access public; rm -f README.md LICENSE"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styled": {
        "types": "./dist/styled.d.ts",
        "import": "./dist/styled.js"
      },
      "./package.json": "./package.json"
    }
  }
}
